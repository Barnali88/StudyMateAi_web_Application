# StudyMate AI environment file template
# Copy this file to .env and update values.
# Do not put your real API key in this example file.

DATABASE_URL=postgresql://studymate:your_password@localhost:5432/studymate_db

OLLAMA_LOCAL_BASE_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=qwen2.5:0.5b
OLLAMA_LOCAL_MODELS=qwen2.5:0.5b,smollm2,gemma3:270m

# Official Ollama Cloud direct API
# Base API used by the backend: https://ollama.com/api/chat
USE_CLOUD_MODEL=false
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_CLOUD_MODEL=gpt-oss:20b

# The app also tries to fetch available cloud models from https://ollama.com/api/tags.
# This list is the fallback list used if the API key is missing or model listing fails.
OLLAMA_CLOUD_MODELS=minimax-m2.1,minimax-m2.5,minimax-m2.7,gemini-3-flash-preview,cogito-2.1:671b,glm-4.6,glm-5.1,glm-4.7,kimi-k2:1t,kimi-k2-thinking,kimi-k2.6,qwen3-coder-next,qwen3-next,qwen3-coder:480b,deepseek-v3.1:671b,gpt-oss:20b,gpt-oss:120b,gemma3:4b,gemma3:12b,gemma3:27b,gemma3:270m,gemma4:31b,mistral-3:8b,mistral-3:14b,mistral-large-3:675b,devstral-2:123b

MAX_FILE_SIZE_MB=50
MAX_EXTRACT_CHARS=250000
